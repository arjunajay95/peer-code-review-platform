generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    clerkId   String   @unique
    username  String   @unique
    bio       String?
    githubUrl String?
    karma     Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    submissions  Submission[]
    reviews      Review[]
    technologies Technology[]
}

model Technology {
    id   Int    @id @default(autoincrement())
    name String @unique // lowercase, trimmed. Identity AND label (D-17)

    users       User[]
    submissions Submission[]
}

model Submission {
    id          Int      @id @default(autoincrement())
    title       String
    description String
    githubUrl   String
    authorId    Int
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
    criteria     Criterion[]
    reviews      Review[]
    technologies Technology[]

    @@index([createdAt(sort: Desc), id(sort: Desc)]) // feed ordering + window query
    @@index([authorId])
}

model Criterion {
    id           Int    @id @default(autoincrement())
    label        String
    submissionId Int

    submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
    ratings    CriterionRating[]

    @@index([submissionId])
}

model Review {
    id           Int      @id @default(autoincrement())
    feedback     String
    strengths    String
    improvements String
    resources    String?  // optional links, comma-separated or markdown
    reviewerId   Int
    submissionId Int
    createdAt    DateTime @default(now())
    // no updatedAt: reviews are immutable (D-15)

    reviewer   User              @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
    submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
    ratings    CriterionRating[]

    @@unique([reviewerId, submissionId]) // INV-2, and the backbone of the D-13 karma equation
    @@index([submissionId])
    @@index([reviewerId])
}

model CriterionRating {
    id          Int @id @default(autoincrement())
    rating      Int // 1 to 5, enforced by CHECK constraint (§4)
    reviewId    Int
    criterionId Int

    review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
    criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

    @@unique([reviewId, criterionId]) // one rating per criterion per review
    @@index([criterionId])
}
